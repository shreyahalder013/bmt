# Supabase: use the Transaction Pooler URL for DATABASE_URL and the direct URL for DIRECT_URL.
# Replace PROJECT_REF, REGION, and URL_ENCODED_PASSWORD with values from Supabase > Connect.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
AUTH_SECRET="replace-with-at-least-32-random-characters"
OWNER_EMAIL="owner@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Brilliant Minds Tutorials <no-reply@example.com>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"
SUPABASE_STORAGE_BUCKET="gallery"
REDIS_URL="redis://localhost:6379"
